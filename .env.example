# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Batik Arunika"

# Supabase Service Role (Server Only, for webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# Admin Access (Server Only, single-vendor MVP)
ADMIN_EMAIL=

# Midtrans Payment Gateway (Sandbox)
# Server-only: never prefix with NEXT_PUBLIC_
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Publishable client key for the Snap.js widget
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Biteship Logistics (Server Only)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
