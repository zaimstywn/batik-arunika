# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Batik Arunika"

# Supabase Service Role (Server Only, for webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# Admin Access (Server Only, single-vendor MVP)
ADMIN_EMAIL=

# Xendit Payment Gateway
# Server-only: format usually xnd_development_... or xnd_production_...
XENDIT_SECRET_KEY=
# Webhook verification token set in Xendit Dashboard settings
XENDIT_WEBHOOK_TOKEN=

# Biteship Logistics (Server Only)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
